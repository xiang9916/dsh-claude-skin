{
  "name": "dsh-claude-skin",
  "description": "Claude 风格 DSH Web 界面皮肤（fork 自 @pakiknowledge/dsh-client-ui-skin-claude）：暖黑画布、陶橙点缀、Anthropic 字体模式、跟随原生亮/暗主题",
  "version": "0.2.1",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "skin.json",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs",
    "preview",
    "scripts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiang9916/dsh-claude-skin.git"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
